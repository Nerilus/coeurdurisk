# Application
LOG_LEVEL=INFO
LOG_FILE=/opt/coeurdurisk/logs/coeur_risk.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5

# SMTP (optionnel pour la fonctionnalite d'envoi email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=no-reply@example.com
SMTP_USE_STARTTLS=1

